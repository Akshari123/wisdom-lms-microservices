# Google OAuth 2.0 Credentials (Required for Auth Service)
# Create these in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/login/oauth2/code/google

# Secret used by Auth Service and Gateway to sign/validate Wisdom LMS JWTs
JWT_SECRET=your_secure_jwt_secret

# Internal API key for microservice-to-microservice communication
INTERNAL_API_KEY=your_internal_api_key
